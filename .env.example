# Copy to .env for LOCAL dev only. In production, Doppler injects these
# (project `finding-memeland`, config `prd`, via the Railway integration).
# NEVER commit a real .env. See doppler.md for the canonical list and notes.
#
# IMPORTANT: do NOT put inline comments after a value (e.g. `KEY=val  # note`).
# The .env reader treats everything after `=` as the value. Keep notes on their
# own line, like these.
#
# Naming: several variables keep the historical `FMML_` prefix. The token is $FIND.

# --- Runtime ---
FMML_ENV=local
LOG_LEVEL=INFO

# --- Anthropic (relic identities, clues, oracle replies) ---
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (relic artwork + the blind solver that tests every puzzle clue) ---
OPENAI_API_KEY=sk-proj-xxx
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024
# Blind solver: openai (default, independent from the clue writer) / anthropic / off
RELIC_SOLVER_BACKEND=openai
RELIC_SOLVER_MODEL=gpt-4.1-mini

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# --- X API (single developer app; the main account posts clues and reads claims) ---
X_API_KEY=xxx
X_API_SECRET=xxx
X_BEARER_TOKEN=xxx
X_MAIN_ACCESS_TOKEN=xxx
X_MAIN_ACCESS_SECRET=xxx

# --- Base chain / money path ---
BASE_RPC_URL=https://mainnet.base.org
# $FIND token contract
FMML_TOKEN_ADDRESS=
# EOA that pays prizes; holds at most a couple of hunts' worth
HOT_WALLET_PRIVATE_KEY=
# Hardcoded per-hunt ceiling in tokens (0 = hunts refused)
PAYOUT_CAP_FMML=0
# Random high-entropy secret; revealed per hunt in the Winner Announcement
INTEGRITY_SALT=

# --- Telegram (operator console; only this chat can run commands) ---
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_ADMIN_CHAT_ID=

# --- Relic hunts (the production mechanic) ---
# true = /launch stages a relic hunt. false = legacy persona path.
RELIC_LAUNCH=true
# Fernet key that encrypts every relic identity at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING THIS KEY LOSES EVERY IDENTITY IN THE POOL. Back it up before /relic_new.
RELIC_POOL_KEY=
# Mint wallets, one per relic: comma-separated refs, e.g. RX05. For each ref the
# key pair lives as <REF>_ADDR / <REF>_PK (see below). Only needed to MINT.
RELIC_WALLET_REFS=
RX05_ADDR=
RX05_PK=
# Pins relic metadata + artwork to IPFS. Only needed to MINT.
PINATA_JWT=
# Mint backend: manifold (default) / relicnft (bespoke contract, dry-run harness)
RELIC_MINT_BACKEND=manifold
# Findability gate at /launch: the relic must be indexed by name on a marketplace.
# At least one key; the gate refuses to launch without a confirmed hit.
RARIBLE_API_KEY=
OPENSEA_API_KEY=
# Verified "trail" clues (off = direct clues only)
RELIC_TRAILS_ENABLED=false

# --- Game parameters ---
# Minimum pot accepted by /launch, in tokens (default 100M)
MIN_PRIZE_FMML=100000000
# Non-holder winner's share of the pot, in percent (holders get 100)
NON_HOLDER_PRIZE_PCT=10
# Standing public holding floor, in tokens. Only ever reduce; announce reductions.
HOLDING_FLOOR_FMML=10000000
# Continuous-hold window in hours for the full pot (0 = balance at claim time only)
HOLDING_HOURS=0
# Clue cadence band, seconds (a gap is drawn uniformly per clue)
CLUE_MIN_GAP_S=360
CLUE_MAX_GAP_S=1560
# Claims
CLAIM_CHANNEL=post
CLAIM_GUESS_CAP=5
WALLET_TIMEOUT_S=600
CLAIM_SWEEP_EVERY_N=5
# Watchdog: alert if a live hunt completes no loop cycle for this long
WATCHDOG_STALL_S=600
# Daily oracle post drafts (Telegram approval; nothing publishes without it)
FILLER_DAILY_ENABLED=true
FILLER_HOUR_UTC=15

# --- Legacy (persona era; unused by relic hunts, kept for the old code paths) ---
PREP_WINDOW_H=24
PREP_POSTS_N=3
MIN_WARMUP_DAYS=7
PERSONA_REGISTER=medium
PRIZE_USD_MIN=200
PRIZE_USD_MAX=500
MIN_PRIZE_USD=200
FMML_USD_PRICE=0
HOLDING_FLOOR_USD=20
TOTAL_SUPPLY=100000000000
